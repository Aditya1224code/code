#include <iostream>
using namespace std;
class Base1{
  int data1;
  public:
 Base1(int i){
     data1=i;
     cout<<"base1 class constructor isi called"<<endl;
     
 }
 void printdata1(){
     cout<<"data 1 is "<<data1<<endl;
 }
};
class Base2{
  int data2;
  public:
  Base2(int i){
      data2=i;
      cout<<"base2 class constructor is called"<<endl;
      
  }
  void printdata2(){
      cout<<"data2 is"<<data2<<endl;
  }
  
};
class Derived:public Base1, public Base2{
  int derived1,derived2;
  public:
  Derived(int a,int b ,int c,int d):Base1(a),Base2(b){
      derived1=c;
      derived2=d;
      cout<<"derived class contructor is called"<<endl;
  }
  void printderived(){
      cout<<"derived1 is "<<derived1<<endl;
      cout<<"derived2 is "<<derived2<<endl;
  }
};
int main() {
    Derived d(1,2,3,4);
    d.printdata1();
    d.printdata2();
    d.printderived();

    return 0;
}
